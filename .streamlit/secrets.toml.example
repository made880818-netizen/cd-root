# 이 파일을 secrets.toml로 복사해 값을 채운다 (secrets.toml은 .gitignore 대상이라 저장소에 올라가지 않는다)
# 배포(Streamlit Community Cloud)에서는 앱 설정의 Secrets 칸에 같은 내용을 붙여 넣는다.

ANTHROPIC_API_KEY = ""
ANTHROPIC_BASE_URL = ""          # 공식 주소를 쓰면 비워 둔다

# 선택: 끝난 검토의 요약을 Supabase에 저장한다 (비우면 저장하지 않는다). service_role 키는 서버에서만 쓰고 절대 공개하지 않는다.
SUPABASE_URL = ""                # 예: https://abcdxxxx.supabase.co
SUPABASE_SERVICE_KEY = ""

# 선택: 공유 API 예산 보호 (기본값: 방문자당 3번, 서버 전체 시간당 30번)
# AI_RUNS_PER_SESSION = "3"
# AI_RUNS_PER_HOUR = "30"
